{
  "name": "mcp-elicitation-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Demo of MCP elicitation (form and URL mode) on the 2026-07-28 spec",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "tsx src/client/main.ts",
    "dev:web-backend": "tsx watch src/web/backend/main.ts",
    "dev:web": "vite",
    "start:server": "node dist/server/main.js",
    "start:client": "node dist/client/main.js",
    "start:web-backend": "node dist/web/backend/main.js",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:web": "tsx scripts/smoke-web.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.4"
  }
}
