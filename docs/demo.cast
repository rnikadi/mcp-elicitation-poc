[17.884, "o", "\r\n\u001b[G\u001b[?25h\r\n"]
[17.884, "o", "\u001b[1m  You are about to send:\u001b[22m\r\n  \u001b[2mdepartureDate   \u001b[22m \"2026-12-01\"\r\n"]
[17.884, "o", "  \u001b[2mnights          \u001b[22m 3\r\n"]
[17.884, "o", "  \u001b[2mtravelers       \u001b[22m 2\r\n"]
[17.884, "o", "  \u001b[2mcabin           \u001b[22m \"premium\"\r\n"]
[17.884, "o", "  \u001b[2mextras          \u001b[22m [\"breakfast\",\"airport-transfer\"]\r\n"]
[17.885, "o", "  \u001b[2mcontactEmail    \u001b[22m \"ada@example.com\"\r\n"]
[17.885, "o", "\r\n"]
[17.885, "o", "\u001b[34m?\u001b[39m \u001b[1mSend this to Trip Planner (elicitation demo)?\u001b[22m\r\n\u001b[36m> Send\u001b[39m\r\n  Edit answers\r\n  Decline\r\n  Cancel\r\n\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[21.504, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[32m√\u001b[39m \u001b[1mSend this to Trip Planner (elicitation demo)?\u001b[22m \u001b[36mSend\u001b[39m\u001b[53G"]
[21.505, "o", "\r\n\u001b[G\u001b[?25h\r\n\u001b[32m→ client to server\u001b[39m\r\n\u001b[2m{\r\n  \"method\": \"tools/call\",\r\n  \"params\": {\r\n    \"name\": \"plan_trip\",\r\n    \"arguments\": {\r\n      \"destination\": \"Lisbon\"\r\n    },\r\n    \"inputResponses\": {\r\n      \"trip_details\": {\r\n        \"action\": \"accept\",\r\n        \"content\": {\r\n          \"departureDate\": \"2026-12-01\",\r\n          \"nights\": 3,\r\n          \"travelers\": 2,\r\n          \"cabin\": \"premium\",\r\n          \"extras\": [\r\n            \"breakfast\",\r\n            \"airport-transfer\"\r\n          ],\r\n          \"contactEmail\": \"ada@example.com\"\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\u001b[22m\r\n"]
[21.523, "o", "\r\n\u001b[35m← server to client\u001b[39m\r\n\u001b[2m{\r\n  \"_meta\": {\r\n    \"io.modelcontextprotocol/serverInfo\": {\r\n      \"name\": \"trip-planner\",\r\n      \"title\": \"Trip Planner (elicitation demo)\",\r\n      \"version\": \"0.1.0\"\r\n    }\r\n  },\r\n  \"content\": [\r\n    {\r\n      \"type\": \"text\",\r\n      \"text\": \"Quote Q-CA2897: 3 nights in Lisbon from 2026-12-01\\n2 traveler(s), premium cabin, extras: breakfast, airport-transfer\\nTotal: €1210. Confirmation will go to ada@example.com.\\nCall checkout with quoteId \\\"Q-CA2897\\\" to pay.\"\r\n    }\r\n  ],\r\n  \"structuredContent\": {\r\n    \"id\": \"Q-CA2897\",\r\n    \"destination\": \"Lisbon\",\r\n    \"departureDate\": \"2026-12-01\",\r\n    \"nights\": 3,\r\n    \"travelers\": 2,\r\n    \"cabin\": \"premium\",\r\n    \"extras\": [\r\n      \"breakfast\",\r\n      \"airport-transfer\"\r\n    ],\r\n    \"contactEmail\": \"ada@example.com\",\r\n    \"totalEur\": 1210\r\n  }\r\n}\u001b[22m\r\n\r\n\u001b[32mQuote Q-CA2897: 3 nights in Lisbon from 2026-12-01\r\n2 traveler(s), premium cabin, extras: breakfast, airport-transfer\r\nTotal: €1210. Confirmation will go to ada@example.com.\r\nCall checkout with quoteId \"Q-CA2897\" to pay.\u001b[39m\r\n\r\n"]
[21.524, "o", "\u001b[34m?\u001b[39m \u001b[1mWhat next?\u001b[22m\r\n\u001b[36m> Plan a trip (form mode)\u001b[39m\r\n  Check out quote Q-CA2897 (URL mode)\r\n  Hide protocol messages\r\n  Quit\r\n\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[27.842, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[34m?\u001b[39m \u001b[1mWhat next?\u001b[22m\r\n  Plan a trip (form mode)\r\n\u001b[36m> Check out quote Q-CA2897 (URL mode)\u001b[39m\r\n  Hide protocol messages\r\n  Quit\r\n\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[27.945, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[32m√\u001b[39m \u001b[1mWhat next?\u001b[22m \u001b[36mCheck out quote Q-CA2897 (URL mode)\u001b[39m\u001b[49G"]
[27.945, "o", "\r\n\u001b[G\u001b[?25h"]
[27.945, "o", "\r\n\u001b[32m→ client to server\u001b[39m\r\n\u001b[2m{\r\n  \"method\": \"tools/call\",\r\n  \"params\": {\r\n    \"name\": \"checkout\",\r\n    \"arguments\": {\r\n      \"quoteId\": \"Q-CA2897\"\r\n    }\r\n  }\r\n}\u001b[22m\r\n"]
[27.96, "o", "\r\n\u001b[35m← server to client\u001b[39m\r\n\u001b[2m{\r\n  \"resultType\": \"input_required\",\r\n  \"inputRequests\": {\r\n    \"payment\": {\r\n      \"method\": \"elicitation/create\",\r\n      \"params\": {\r\n        \"message\": \"Pay €1210 for quote Q-CA2897 (Lisbon) on the secure payment page.\",\r\n        \"url\": \"http://localhost:3000/pay/547d87b8-d3ab-470e-9709-19a94d54fb9f\",\r\n        \"mode\": \"url\"\r\n      }\r\n    }\r\n  },\r\n  \"requestState\": \"v1.eyJwIjp7InBheW1lbnRJZCI6IjU0N2Q4N2I4LWQzYWItNDcwZS05NzA5LTE5YTk0ZDU0ZmI5ZiJ9LCJleHAiOjE3OTMwMTM1MjgsImIiOiJDWkZ1WDFhb2o0OEkwQ295MDl0X0hRIn0.oDE56r8kx6FSfv5b-toSIAJBbU973OSzukD7YfTSsTc\",\r\n  \"_meta\": {\r\n    \"io.modelcontextprotocol/serverInfo\": {\r\n      \"name\": \"trip-planner\",\r\n      \"title\": \"Trip Planner (elicitation demo)\",\r\n      \"version\": \"0.1.0\"\r\n    }\r\n  }\r\n}\u001b[22m\r\n"]
[27.961, "o", "\r\n\u001b[44m\u001b[37m\u001b[1m Trip Planner (elicitation demo) \u001b[22m\u001b[39m\u001b[49m \u001b[2mis asking (URL mode)\u001b[22m\r\n  Pay €1210 for quote Q-CA2897 (Lisbon) on the secure payment page.\r\n\r\n  \u001b[2mSite:\u001b[22m \u001b[1m\u001b[33mlocalhost:3000\u001b[39m\u001b[22m\r\n  \u001b[2mFull link:\u001b[22m http://localhost:3000/pay/547d87b8-d3ab-470e-9709-19a94d54fb9f\r\n\u001b[2m  The page talks to the server directly. This client never sees what you enter there.\u001b[22m\r\n\r\n"]
[27.962, "o", "\u001b[34m?\u001b[39m \u001b[1mOpen this link?\u001b[22m\r\n\u001b[36m> Open it (I will continue in my browser)\u001b[39m\r\n  Decline\r\n  Cancel\r\n\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[32.031, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[32m√\u001b[39m \u001b[1mOpen this link?\u001b[22m \u001b[36mOpen it (I will continue in my browser)\u001b[39m\u001b[58G"]
[32.031, "o", "\r\n\u001b[G\u001b[?25h"]
[32.031, "o", "\r\n  \u001b[1mOpen this link in your browser:\u001b[22m\r\n"]
[32.031, "o", "  \u001b[4m\u001b[36mhttp://localhost:3000/pay/547d87b8-d3ab-470e-9709-19a94d54fb9f\u001b[39m\u001b[24m\r\n"]
[32.031, "o", "\u001b[2m  Waiting for the server (finish in your browser)...\u001b[22m\r\n"]
[32.031, "o", "\r\n\u001b[32m→ client to server\u001b[39m"]
[32.032, "o", "\r\n"]
[32.032, "o", "\u001b[2m{\r\n  \"method\": \"tools/call\",\r\n  \"params\": {\r\n    \"name\": \"checkout\",\r\n    \"arguments\": {\r\n      \"quoteId\": \"Q-CA2897\"\r\n    },\r\n    \"inputResponses\": {\r\n      \"payment\": {\r\n        \"action\": \"accept\"\r\n      }\r\n    },\r\n    \"requestState\": \"v1.eyJwIjp7InBheW1lbnRJZCI6IjU0N2Q4N2I4LWQzYWItNDcwZS05NzA5LTE5YTk0ZDU0ZmI5ZiJ9LCJleHAiOjE3OTMwMTM1MjgsImIiOiJDWkZ1WDFhb2o0OEkwQ295MDl0X0hRIn0.oDE56r8kx6FSfv5b-toSIAJBbU973OSzukD7YfTSsTc\"\r\n  }\r\n}\u001b[22m\r\n"]
[32.043, "o", "\r\n\u001b[35m← server to client\u001b[39m\r\n\u001b[2m{\r\n  \"_meta\": {\r\n    \"io.modelcontextprotocol/serverInfo\": {\r\n      \"name\": \"trip-planner\",\r\n      \"title\": \"Trip Planner (elicitation demo)\",\r\n      \"version\": \"0.1.0\"\r\n    }\r\n  },\r\n  \"content\": [\r\n    {\r\n      \"type\": \"text\",\r\n      \"text\": \"Booked! Lisbon, 3 nights from 2026-12-01. Confirmation TRIP-B35626, €1210 charged.\"\r\n    }\r\n  ],\r\n  \"structuredContent\": {\r\n    \"quoteId\": \"Q-CA2897\",\r\n    \"confirmationCode\": \"TRIP-B35626\"\r\n  }\r\n}\u001b[22m\r\n\r\n\u001b[32mBooked! Lisbon, 3 nights from 2026-12-01. Confirmation TRIP-B35626, €1210 charged.\u001b[39m\r\n\r\n"]
