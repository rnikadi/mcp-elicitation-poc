[6.678, "o", "\u001b[2K\u001b[G\u001b[32m√\u001b[39m \u001b[1mWhere to?\u001b[22m \u001b[36mLisbon\u001b[39m\u001b[19G"]
[6.678, "o", "\r\n\u001b[G\u001b[?25h"]
[6.679, "o", "\r\n\u001b[32m→ client to server\u001b[39m\r\n"]
[6.679, "o", "\u001b[2m{\r\n  \"method\": \"tools/call\",\r\n  \"params\": {\r\n    \"name\": \"plan_trip\",\r\n    \"arguments\": {\r\n      \"destination\": \"Lisbon\"\r\n    }\r\n  }\r\n}\u001b[22m\r\n"]
[6.699, "o", "\r\n\u001b[35m← server to client\u001b[39m\r\n\u001b[2m{\r\n  \"resultType\": \"input_required\",\r\n  \"inputRequests\": {\r\n    \"trip_details\": {\r\n      \"method\": \"elicitation/create\",\r\n      \"params\": {\r\n        \"mode\": \"form\",\r\n        \"message\": \"Tell me about your trip to Lisbon.\",\r\n        \"requestedSchema\": {\r\n          \"type\": \"object\",\r\n          \"properties\": {\r\n            \"departureDate\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"date\",\r\n              \"title\": \"Departure date\",\r\n              \"description\": \"YYYY-MM-DD\"\r\n            },\r\n            \"nights\": {\r\n              \"type\": \"integer\",\r\n              \"title\": \"Nights\",\r\n              \"minimum\": 1,\r\n              \"maximum\": 14,\r\n              \"default\": 3\r\n            },\r\n            \"travelers\": {\r\n              \"type\": \"integer\",\r\n              \"title\": \"Travelers\",\r\n              \"minimum\": 1,\r\n              \"maximum\": 6,\r\n              \"default\": 2\r\n            },\r\n            \"cabin\": {\r\n              \"type\": \"string\",\r\n              \"title\": \"Cabin class\",\r\n              \"oneOf\": [\r\n                {\r\n                  \"const\": \"economy\",\r\n                  \"title\": \"Economy\"\r\n                },\r\n                {\r\n                  \"const\": \"premium\",\r\n                  \"title\": \"Premium economy\"\r\n                },\r\n                {\r\n                  \"const\": \"business\",\r\n                  \"title\": \"Business\"\r\n                }\r\n              ],\r\n              \"default\": \"economy\"\r\n            },\r\n            \"extras\": {\r\n              \"type\": \"array\",\r\n              \"title\": \"Extras\",\r\n              \"items\": {\r\n                \"type\": \"string\",\r\n                \"enum\": [\r\n                  \"breakfast\",\r\n                  \"airport-transfer\",\r\n                  \"travel-insurance\"\r\n                ]\r\n              },\r\n              \"default\": []\r\n            },\r\n            \"contactEmail\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"email\",\r\n              \"title\": \"Contact email\"\r\n            }\r\n          },\r\n          \"required\": [\r\n            \"departureDate\",\r\n            \"nights\",\r\n            \"travelers\",\r\n            \"cabin\",\r\n            \"contactEmail\"\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  },\r\n  \"_meta\": {\r\n    \"io.modelcontextprotocol/serverInfo\": {\r\n      \"name\": \"trip-planner\",\r\n      \"title\": \"Trip Planner (elicitation demo)\",\r\n      \"version\": \"0.1.0\"\r\n    }\r\n  }\r\n}\u001b[22m\r\n"]
[6.699, "o", "\r\n"]
[6.7, "o", "\u001b[44m\u001b[37m\u001b[1m Trip Planner (elicitation demo) \u001b[22m\u001b[39m\u001b[49m \u001b[2mis asking (form mode)\u001b[22m\r\n  Tell me about your trip to Lisbon.\r\n"]
[6.7, "o", "\r\n"]
